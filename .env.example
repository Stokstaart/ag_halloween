# Serverinstellingen
HOST=0.0.0.0
PORT=8088
DEBUG=false

# Beveiliging: optioneel toegangstoken.
# Laat leeg voor onbeveiligd lokaal netwerkgebruik (met waarschuwingsbadge in de controller).
# Wanneer ingesteld: gebruik ?token=JOUW_TOKEN of Authorization header.
# Let op: tokens in query strings kunnen uitlekken via browsergeschiedenis en logbestanden.
AUTH_TOKEN=

# Effectengine timings (in seconden)
COOLDOWN_SECONDS=0
MAX_EFFECT_DURATION_SECONDS=300

# Standaard achtergrondvideo (relatief aan de projectroot of mediadirectory)
DEFAULT_BACKGROUND=media/background/ambient_fog.mp4
