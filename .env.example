# Serverinstellingen
HOST=0.0.0.0
PORT=8088
DEBUG=false

# Beveiliging: optioneel wachtwoord / toegangstoken (bv: PASSWORD=SpookHuis2026!)
# Laat leeg voor onbeveiligd lokaal LAN-gebruik.
# Wanneer ingesteld: toont automatisch een Halloween-inlogscherm en bewaart een sessie van 30 dagen.
AUTH_TOKEN=
PASSWORD=

# Effectengine timings (in seconden)
COOLDOWN_SECONDS=0
MAX_EFFECT_DURATION_SECONDS=300

# Standaard achtergrondvideo (relatief aan de projectroot of mediadirectory)
DEFAULT_BACKGROUND=media/background/ambient_fog.mp4
